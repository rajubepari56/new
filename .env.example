# Environment variables for Netlify (Site configuration > Environment variables).
# Copy the names, never commit real values. The website never exposes any of these to the browser.

# n8n production webhook URL that receives each lead (server side only)
N8N_WEBHOOK_URL=
# Optional shared secret sent as the x-webhook-secret header (set the same value in n8n)
N8N_WEBHOOK_SECRET=
# Optional. Defaults to https://rajubepari.netlify.app. Used for the same-origin check.
SITE_URL=https://rajubepari.netlify.app
# Optional random string used when hashing IP addresses for rate limiting
LEAD_HASH_SALT=

# Leads dashboard (/dashboard/)
ADMIN_KEY=
NETLIFY_API_TOKEN=
SITE_ID=
